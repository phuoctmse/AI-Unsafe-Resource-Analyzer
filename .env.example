BACKEND_PORT=3001
FRONTEND_PORT=3000
WORKER_PORT=8001

# Postgres
POSTGRES_DB=aura
POSTGRES_USER=aura
POSTGRES_PASSWORD=change_me

# MinIO / S3
MINIO_ROOT_USER=aura
MINIO_ROOT_PASSWORD=change_me
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me
S3_BUCKET="aura-images"

# Derived (used by backend/worker directly)
DATABASE_URL="postgresql://aura:change_me@localhost:5433/aura?schema=public"
REDIS_URL="redis://localhost:6379"

# Internal API key shared between backend and worker
INTERNAL_API_KEY=change_me

# aura-ai-worker (optional — defaults match mock inference)
# HF_TOKEN=hf_your_token_here   # get from https://huggingface.co/settings/tokens (read-only is enough)
# MODEL_VERSION=mock-deterministic-0.1.0
# LABEL_SET_VERSION=aura-labels-v1
# THRESHOLDS_VERSION=aura-thresholds-v1
# WORKER_VERSION=dev
# UNSAFE_THRESHOLD=0.22
# USE_MOCK_INFERENCE=false
# CLIP_MODEL_ID=openai/clip-vit-base-patch32
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=aura
# S3_SECRET_KEY=aurasecret
# S3_BUCKET=aura-images
# MAX_IMAGE_SIDE=512
# INFERENCE_TIMEOUT_S=120
# DOWNLOAD_TIMEOUT_S=30
# MAX_CONCURRENT_INFERENCE=1
# BACKEND_CALLBACK_RETRIES=3
# INTERNAL_API_KEY must match backend INTERNAL_API_KEY
