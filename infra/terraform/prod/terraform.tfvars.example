# Copy this file to terraform.tfvars and fill in real values
# terraform.tfvars is gitignored — never commit it

# ── Required: no defaults ─────────────────────────────────────────────────────

domain_name        = "yourdomain.com"
images_bucket_name = "aura-images-prod-<unique-suffix>"

# ── Secrets: use TF_VAR_* env vars instead of putting here ───────────────────
# db_password      = "change_me"
# internal_api_key = "change_me"
# hf_token         = "hf_xxxxxxxxxxxx"

# ── ECS images: injected by CD pipeline, placeholder for local plan ──────────
backend_image  = "placeholder/aura-backend:latest"
frontend_image = "placeholder/aura-frontend:latest"
worker_image   = "placeholder/aura-worker:latest"

# ── Overrides (optional — defaults are fine for production) ──────────────────
# aws_region                = "ap-southeast-1"
# project                   = "aura"
# vpc_cidr                  = "10.0.0.0/16"
# db_instance_class         = "db.t4g.micro"
# redis_node_type           = "cache.t4g.micro"
# ecr_image_retention_count = 10
# worker_desired_count      = 2
# worker_max_count          = 10
